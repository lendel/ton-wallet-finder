{
  "name": "ton-wallet-finder",
  "version": "5.1.0",
  "description": "Vanity address generator for TON blockchain — find a wallet address (v3r2 / v4r2 / v5r1) ending with any custom string.",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "wordlist.js",
    "index.d.ts",
